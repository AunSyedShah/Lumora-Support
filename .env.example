# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me
# Time zone for report dates and daily counts (IANA name, e.g. Asia/Karachi, Europe/London, UTC)
TIME_ZONE=Asia/Karachi

# JWT
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# GenAI provider (DeepSeek, OpenAI-compatible)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash

# Demo accounts created by seed_demo_data
DEMO_PASSWORD=Lumora@2026

# GenAI pipeline (optional overrides)
GENAI_THINKING=disabled
GENAI_TEMPERATURE=0.2
GENAI_MAX_TOKENS=3000
GENAI_MAX_ATTEMPTS=3

# Email (optional). Leave EMAIL_HOST empty to save emails as files in support_nova_project/sent_emails/.
# Gmail example: smtp.gmail.com / 587 and imap.gmail.com / 993 with an app password.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Lumora Support <support@lumora.example>
IMAP_HOST=
IMAP_PORT=993
FRONTEND_URL=http://localhost:5173
